# Simulation output — universes are reproducible from (version, seed,
# intervention log), so they are never committed. Share coordinates, not worlds.
out/
*.db
*.sqlite
*.sqlite3

# Toolchain — everything here is regenerated by tools/setup.sh
# (/lua_modules and /.luarocks spelled exactly as `luarocks init` checks,
# so it does not append duplicates)
.toolchain/
/lua_modules
/.luarocks
/lua
/luarocks

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Local secrets
.fizzy.yaml
.env
