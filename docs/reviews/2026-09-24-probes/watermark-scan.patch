 end
 
+-- EXPERIMENT (review lane): every belief about a kind learned strictly
+-- after a tick, arrival order. learned is non-decreasing in arrival
+-- order (the courier stamps each delivery with the current tick), so
+-- a backward scan can stop at the first older stamp: exact, no window.
+function Belief:since(kind, after)
+   local held = self.by_kind[kind]
+   local out = {}
+   if not held then
+      return out
+   end
+   local first = #held + 1
+   while first > 1 and held[first - 1].learned > after do
+      first = first - 1
+   end
+   for i = first, #held do
+      out[#out + 1] = copy(held[i])
+   end
+   return out
+end
+
+-- EXPERIMENT: newest belief of a kind satisfying a predicate, no window.
+function Belief:newest_where(kind, pred)
+   local held = self.by_kind[kind]
+   if not held then
+      return nil
+   end
+   for i = #held, 1, -1 do
+      if pred(held[i]) then
+         return copy(held[i])
+      end
+   end
+   return nil
+end
+
 function Belief:len()
    return self.received
 end
